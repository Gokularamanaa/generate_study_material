# LLM Provider Configuration
# Set LLM_PROVIDER to 'openai', 'gemini', 'openrouter', or 'grok' (or leave empty to auto-detect based on available keys)
LLM_PROVIDER=openai

# OpenAI API Key (obtain from https://platform.openai.com/)
OPENAI_API_KEY=your_openai_api_key_here

# Gemini API Key (obtain from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenRouter API Key (obtain from openrouter.ai)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Grok / xAI API Key (obtain from console.x.ai)
GROK_API_KEY=your_grok_api_key_here

# LLM Model Name
# OpenAI examples: gpt-4o, gpt-4o-mini
# Gemini examples: gemini-2.0-flash, gemini-1.5-pro
# OpenRouter examples: meta-llama/llama-3.3-70b-instruct, openai/gpt-4o
# Grok examples: grok-2-latest
LLM_MODEL=gpt-4o

# General Settings
LOG_LEVEL=INFO
# OUTPUT_DIR=output

